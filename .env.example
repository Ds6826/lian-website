# Server
PORT=8000
BASE_URL=http://localhost:8000
SESSION_SECRET=replace_with_a_long_random_string

# Clerk — https://dashboard.clerk.com
# Use Clerk development keys for localhost. Use production keys/custom domains
# only for your deployed domain, such as https://www.lians.ai.
CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_
CLERK_WEBHOOK_SECRET=whsec_
CLERK_BILLING_PLAN_ID_FREE=
CLERK_BILLING_PLAN_ID_STARTER=
CLERK_BILLING_PLAN_ID_GROWTH=
CLERK_BILLING_PLAN_ID_PRO=
CLERK_BILLING_PLAN_ID_ENTERPRISE=

# Managed control plane to Lians engine. The admin secret stays server-side.
LIANS_API_URL=https://your-lians-engine.example
LIANS_ADMIN_SECRET=

# Optional agent integration examples (MCP server in .mcp.json)
# Get a key at https://www.lians.ai/login, or self-host:
#   git clone https://github.com/ebeirne/Lians2 && docker compose up --build
LIANS_URL=https://agentmem-lotus.fly.dev
LIANS_API_KEY=
LIANS_AGENT_ID=lian-website-dev
# Upstash Redis — add via Vercel Marketplace > Upstash Redis, then link to project
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional error monitoring.
SENTRY_DSN=
