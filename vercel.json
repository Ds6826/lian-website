{
  "version": 2,
  "builds": [
    {
      "src": "api/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["*.html", "*.css", "app.js", "console-api.js", "governor.js", "script.js"]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/api/server.js" }
  ]
}
